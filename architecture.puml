@startuml architecture
' ============================================================================
'  Direct API vs Kafka - Load Test Architecture (7 Cloud VMs)
'  Order Service (OS) -> Payment Service (PS), 3 flows compared:
'    A. Direct HTTP            (OS calls PS synchronously)
'    B. Kafka + DB polling     (OS publishes, then polls PS's DB for status)
'    C. Kafka + result event   (OS publishes, PS publishes result back)
'  Only one flow is active per test run (switched by config).
'  Every component runs on its own VM, so every flow pays a real network hop.
' ============================================================================

title Direct API vs Kafka - Load Test Architecture (7 VMs on GCP)

skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 10
skinparam nodesep 60
skinparam ranksep 70
skinparam ArrowThickness 1.5

skinparam cloud {
  BackgroundColor #F7F9FC
  BorderColor #8A9BB5
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #8A9BB5
}
skinparam node {
  BackgroundColor #EEF3FB
  BorderColor #4A6FA5
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #4A6FA5
}
skinparam queue {
  BackgroundColor #FFF4E5
  BorderColor #D98A1F
}
skinparam database {
  BackgroundColor #EAF6EE
  BorderColor #3C8D5A
}
skinparam note {
  BackgroundColor #FAFAFA
  BorderColor #AAAAAA
}

actor "Engineer\n(laptop)" as engineer

cloud "Google Cloud (Free Trial, 8 vCPU total) - region asia-southeast2 (Jakarta)" as provider {
  rectangle "VPC loadtest-vpc 10.0.0.0/16 - no public IPs, outbound via Cloud NAT, SSH via IAP" as vpc {

    node "**VM1 - load-gen** 10.0.0.11\nn1-standard-1 (1 vCPU / 3.75 GB) - zone a" as vm1 {
      component "k6\narrival-rate scenarios\nS1-S5 (up to 150 req/s)" as k6
    }

    node "**VM2 - order** 10.0.0.12\nn1-standard-1 (1 vCPU / 3.75 GB) - zone a" as vm2 {
      component "Order Service (OS)\n:8080" as os
    }

    node "**VM3 - payment** 10.0.0.13\nn1-standard-1 (1 vCPU / 3.75 GB) - zone b" as vm3 {
      component "Payment Service (PS)\n:8081\n**max 10 in-flight payments**\n(~44 payments/s capacity)" as ps
    }

    node "**VM4 - external gateway** 10.0.0.14\nn1-standard-1 (1 vCPU / 3.75 GB) - zone b" as vm4 {
      component "Payment Gateway Mock\n(stands in for bank / Midtrans / Xendit)\n:8082 - 150-300 ms, 5% errors" as bank
    }

    node "**VM5 - broker: Kafka (KRaft)** 10.0.0.15\nn1-standard-1 (1 vCPU / 3.75 GB) - zone a" as vm5 {
      queue "topic: payment.requested\n(10 partitions, + payment.dlq)" as t_req
      queue "topic: payment.completed\n/ payment.failed" as t_res
    }

    node "**VM6 - database: PostgreSQL** 10.0.0.16\nn1-standard-1 (1 vCPU / 3.75 GB) - zone b" as vm6 {
      database "orders_db\n(owned by OS)" as orders_db
      database "payments_db\n(owned by PS)\nrequested_at / started_at /\ncompleted_at (DB clock)" as payments_db
    }

    node "**VM7 - observability** 10.0.0.17\ne2-standard-2 (2 vCPU / 8 GB) - zone b" as vm7 {
      component "grafana/otel-lgtm\n\nOTel Collector :4317\nTempo (traces) | Loki (logs)\nMimir (metrics) | Grafana :3000" as lgtm
    }
  }
}

note bottom of vm7
  **Telemetry from every VM (OTLP):**
  VM1 k6 metrics | VM2/VM3 traces, metrics, logs
  VM4 gateway latency | VM5 Kafka consumer lag
  VM6 Postgres connections & query rate
  + host CPU / memory for all VMs
end note

' ---------------------------------------------------------------- layout hints
vm1 -[hidden]down- vm2
vm2 -[hidden]down- vm3
vm3 -[hidden]down- vm4
t_req -[hidden]down- t_res
orders_db -[hidden]right- payments_db

' ---------------------------------------------------------------- operator access
engineer -[#777777,dashed]-> vpc : Cloud Shell: gcloud create/delete\nIAP SSH (run k6) | IAP tunnel (Grafana)

' ---------------------------------------------------------------- load (all flows)
k6 -[#333333,bold]down-> os : HTTP POST /orders

' ---------------------------------------------------------------- flow A: direct
os -[#1F6FEB,bold]down-> ps : <color:#1F6FEB>**A** HTTP POST /payments</color>\n<color:#1F6FEB>OS blocks, timeout 1 s</color>

' ---------------------------------------------------------------- flows B & C: via Kafka
os -[#D98A1F,bold]-> t_req : <color:#D98A1F>**B/C** publish</color>
t_req -[#D98A1F,bold]-> ps : <color:#D98A1F>**B/C** consume</color>\n<color:#D98A1F>pull at own pace</color>
os -[#C0392B,dashed,thickness=2]-> payments_db : <color:#C0392B>**B** poll payment status</color>\n<color:#C0392B>shared-DB anti-pattern</color>
ps -[#8E44AD,bold]-> t_res : <color:#8E44AD>**C** publish result</color>
t_res -[#8E44AD,bold]-> os : <color:#8E44AD>**C** consume result</color>

' ---------------------------------------------------------------- shared by all flows
os -[#333333]-> orders_db : write order
ps -[#333333]down-> bank : charge
ps -[#333333]-> payments_db : write payment status

legend right
  |= Line |= Meaning |
  | <color:#333333>**black**</color> | Load from k6 + calls shared by every flow |
  | <color:#1F6FEB>**blue**</color> | **Flow A** - Direct HTTP (synchronous) |
  | <color:#D98A1F>**orange**</color> | **Flow B / C** - OS > Kafka > PS |
  | <color:#C0392B>**red dashed**</color> | **Flow B** - OS polls PS's database |
  | <color:#8E44AD>**purple**</color> | **Flow C** - PS > Kafka > OS (result event) |
  ----
  **Scenarios per flow:** S1 PS copes (20/s) | S2 burst of 100 | S3 overloaded (100/s)
  S4 PS down 10 s | S5 ramp 10 > 150 req/s
  **Runs:** each scenario 3-5x, flows interleaved, median reported
  **Source of truth:** k6 results + DB timestamps
endlegend

footer Only one flow is active per test run; the others are switched off by config.

@enduml
